# ============================================================
#  D&D Rules AI — 环境配置模板
#  复制此文件为 .env 并按需修改
# ============================================================

# ── LLM 推理模式 ─────────────────────────────────────────────
# embedded → 进程内 llama-cpp-python 加载 GGUF 模型（默认，无需外部服务）
# api      → 远程 OpenAI 兼容 API
# local    → 本地 Ollama / LM Studio
# auto     → 启动时探测 local，不可达则回退 api
LLM_MODE=embedded

# embedded 模式：GGUF 模型文件路径
# 相对路径基于项目根目录；绝对路径也可以
# 推荐量化版本：Q4_K_M（4.5GB，8GB显存可用）或 Q5_K_M（5.2GB，质量更好）
LOCAL_LLM_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf

# GPU 层数：-1 = 全部层放 GPU（推荐）；0 = 纯 CPU
LOCAL_LLM_GPU_LAYERS=-1

# 上下文窗口大小（tokens），规则问答场景 4096 足够
LOCAL_LLM_CTX_SIZE=4096

# api / local / auto 模式下的参数（embedded 模式时可留空）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# ── 嵌入模型模式 ──────────────────────────────────────────────
# local → 进程内 sentence-transformers（默认，无需外部服务）
#         GPU≥4GB 使用 BAAI/bge-m3，否则使用 BAAI/bge-small-zh-v1.5
# api   → 远程 OpenAI 兼容 API
# auto  → 优先 local，不可用时回退 api
EMBEDDING_MODE=local

# api / auto 模式下的参数（local 模式时可留空）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ── 数据库配置 ────────────────────────────────────────────────
# 数据库类型: sqlite（默认）或 mysql
DATABASE_TYPE=sqlite

# SQLite 路径（留空使用默认：src/dnd_rules.db）
# SQLITE_PATH=

# MySQL 配置（DATABASE_TYPE=mysql 时填写）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=dnd_rules_db
# MYSQL_USER=root
# MYSQL_PASSWORD=

# ── D&D 资源文件路径 ──────────────────────────────────────────
# CHM 怪物手册 / 规则书源文件根目录
# import_monsters.py 和 import_htm_books.py 从此路径读取 HTM 文件
# 示例（Windows）: D:\dnd-rules-ai\DND5e_chm-main
# 示例（Linux/Mac）: /home/user/dnd-data/DND5e_chm-main
#DND5E_CHM_DIR=D:\dnd-rules-ai\DND5e_chm-main
